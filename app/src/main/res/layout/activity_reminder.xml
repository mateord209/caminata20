<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#EDE7F6">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recordatorio para moverte"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TimePicker
        android:id="@+id/timePicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:timePickerMode="spinner"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvCurrentReminder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sin recordatorio activo"
        android:textColor="#555555"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnSetReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activar recordatorio"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCancelReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancelar recordatorio"
        android:backgroundTint="#F44336"
        android:textColor="#FFFFFF" />

</LinearLayout>